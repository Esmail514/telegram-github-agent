# =============================================================================
# Telegram Configuration
# =============================================================================

# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (get it from @userinfobot)
TELEGRAM_ALLOWED_USER_ID=

# Optional proxy if Telegram API is blocked or restricted in your network
# Example: http://127.0.0.1:7890 or socks5://127.0.0.1:1080
# TELEGRAM_PROXY_URL=

# Timeout in seconds for Telegram Bot API requests (default: 30.0)
TELEGRAM_REQUEST_TIMEOUT=30.0

# =============================================================================
# GitHub App Authentication (Recommended)
# =============================================================================
# See README.md -> "GitHub App Setup" for step-by-step instructions.

# The numeric App ID shown on your GitHub App settings page
GITHUB_APP_ID=

# The Installation ID of your GitHub App (from the installed org/user)
GITHUB_INSTALLATION_ID=

# Path to the private key .pem file downloaded from GitHub App settings
GITHUB_PRIVATE_KEY_PATH=./github-app.pem

# =============================================================================
# GitHub Personal Access Token (PAT fallback — simpler but broader scope)
# =============================================================================
# Leave blank if using GitHub App above.
# Required scopes: repo, read:org
GITHUB_TOKEN=

# =============================================================================
# Workspace
# =============================================================================

# Directory where repositories are cloned by the agent.
#
# AUTO-DETECTION (leave blank or remove this line to use OS defaults):
#   Windows  → C:\Users\<you>\Documents\telegram-agent-workspaces
#   macOS    → /Users/<you>/Documents/telegram-agent-workspaces
#   Linux    → /home/<you>/telegram-agent-workspaces
#   Other    → ./workspaces  (relative to project root)
#
# CUSTOM PATH EXAMPLES — uncomment the one matching your OS:
#
# Windows (absolute):
# WORKSPACE_DIR=C:\Users\YourName\Documents\telegram-agent-workspaces
#
# Windows (relative to project):
# WORKSPACE_DIR=./workspaces
#
# macOS (absolute):
# WORKSPACE_DIR=/Users/yourname/Documents/telegram-agent-workspaces
#
# Linux / Ubuntu / Debian:
# WORKSPACE_DIR=/home/yourname/telegram-agent-workspaces
#
# WSL (Windows Subsystem for Linux):
# WORKSPACE_DIR=/home/yourname/telegram-agent-workspaces
#
# Termux (Android):
# WORKSPACE_DIR=/data/data/com.termux/files/home/telegram-agent-workspaces
#
# Docker / Server (use an absolute path for volume mounting):
# WORKSPACE_DIR=/app/workspaces
#
# Use /sysinfo in Telegram to see the resolved path on your current system.
WORKSPACE_DIR=

# =============================================================================
# Local Projects Directory (Recommended)
# =============================================================================
# Set this to the parent directory on your computer where your local projects live.
# The bot will scan this folder, discover all your projects, link their GitHub repos,
# and let you browse issues, create issues, run agents locally, and manage PRs.
#
# Examples:
# Windows : PROJECTS_DIR=D:\Work  or  PROJECTS_DIR=C:\Users\username\Projects
# macOS   : PROJECTS_DIR=/Users/username/Projects
# Linux   : PROJECTS_DIR=/home/username/projects
#
# You can also set or change this at any time in Telegram using /setdir
PROJECTS_DIR=


# =============================================================================
# Agent Configuration
# =============================================================================

# Default coding agent to use.
# Supported: antigravity, codex, claude, gemini, opencode
DEFAULT_AGENT=antigravity

# Antigravity CLI executable path or name (e.g. agy or antigravity)
ANTIGRAVITY_COMMAND=agy

# Codex CLI executable path or command name
CODEX_COMMAND=codex

# OpenCode executable name or full path
OPENCODE_COMMAND=opencode

# =============================================================================
# AI Provider API Keys (for ✨ Polish with AI feature & agent fallbacks)
# =============================================================================
# Configure at least ONE of these provider keys for AI features.
# Supported: Anthropic Claude, OpenAI GPT, Google Gemini
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVEAI_API_KEY=

# =============================================================================
# Safety Limits
# =============================================================================

# Maximum minutes an agent job may run before being killed
MAX_AGENT_RUNTIME_MINUTES=60

# Maximum times the agent may attempt to fix failing tests before giving up
MAX_FIX_ITERATIONS=5

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
